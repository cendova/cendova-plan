{
  "name": "cendova-plan",
  "private": true,
  "version": "0.1.4",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:open": "vite --open",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/build-info.mjs",
    "plan:dist": "node scripts/plan-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build",
    "shot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@cornerstonejs/core": "^4.22.13",
    "@cornerstonejs/dicom-image-loader": "^4.22.13",
    "@cornerstonejs/tools": "^4.22.13",
    "dicom-parser": "^1.8.21",
    "events": "^3.3.0",
    "fflate": "^0.8.3",
    "html2canvas-pro": "^2.5.2",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dxf-parser": "^1.1.2",
    "marked": "^18.1.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.10"
  }
}
